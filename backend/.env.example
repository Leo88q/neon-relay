# Neon Relay backend example configuration.
# Copy to a private .env file for local/devnet use. Do not commit real secrets.

PORT=8787
NEONRELAY_DB=var/neonrelay.db
NEONRELAY_AUTH_DOMAIN=neonrelay.leo88q.example
NEONRELAY_CHALLENGE_TTL_MS=120000
NEONRELAY_SESSION_TTL_MS=43200000
NEONRELAY_ADMIN_PROPOSAL_TTL_MS=86400000
NEONRELAY_BACKUP_DIR=var/backups
NEONRELAY_EPOCH_MS=604800000
NEONRELAY_CAP_PER_MATCH_MICRO=50000000
NEONRELAY_CAP_DAILY_MICRO=250000000
NEONRELAY_CAP_WEEKLY_MICRO=1000000000

# Solana RPC. Production must set an explicit cluster and HTTPS RPC URL;
# the devnet values below are not production evidence.
NEONRELAY_CLUSTER=devnet
# Paid admission is fail-closed; production requires an explicit 1 only after
# finalized program/mint/treasury verification.
NEONRELAY_MONETIZATION_ENABLED=0
NEONRELAY_RPC_URL=https://api.devnet.solana.com
# Optional fallback RPC on the same chain.
# NEONRELAY_RPC_FALLBACK_URL=https://your-fallback-rpc.example
# Production must pin the finalized genesis hash and provide a fallback.
# NEONRELAY_EXPECTED_GENESIS_HASH=
# NEONRELAY_DEPLOYMENT_MANIFEST=/etc/neonrelay/deployment.mainnet-beta.json

# Reward/game signing and admin tokens. Keep these out of Git.
# Production Watchtower ingestion is disabled unless this service token is set.
# NEONRELAY_WATCHTOWER_INGEST_TOKEN=
# SW-2026-AGI (threat 74): HMAC key for the agent-memory store. Required in
# production whenever the ingest token is set; >= 32 characters; keep secret.
# NEONRELAY_WATCHTOWER_MEMORY_KEY=

# Production FAILS FAST AT BOOT unless ALL of these are set:
#   NEONRELAY_SERVER_SIGNING_PUBLIC_KEY  (canonical base64url Ed25519, 32 bytes)
#   NEONRELAY_GAME_IDENTITY_PUBLIC_KEY   (canonical base64url Ed25519, 32 bytes)
#   NEONRELAY_OPERATOR_TOKEN             (>= 32 chars, distinct from superadmin)
#   NEONRELAY_SUPERADMIN_TOKEN           (>= 32 chars, distinct from operator)
# The two role tokens enforce the two-person rule: operators propose
# seal/close/backup actions, superadmins approve (execute) them.
# NEONRELAY_SERVER_SIGNING_PUBLIC_KEY=
# NEONRELAY_GAME_IDENTITY_PUBLIC_KEY=
# NEONRELAY_ADMIN_TOKEN=            # legacy single token; acts as superadmin
# NEONRELAY_OPERATOR_TOKEN=
# NEONRELAY_SUPERADMIN_TOKEN=

# --- Security gates (SW-2026-09-26 audit iteration 5) -----------------------
# Player-id links: in PRODUCTION POST /v1/wallet/link only accepts a player id
# the operator provisioned for that exact wallet
# (backend/scripts/register_game_account.ts). Set to 1 to enforce the same
# rule early on staging/devnet. Leave unset for local tests.
# NEONRELAY_REQUIRE_REGISTERED_PLAYER_LINK=1
# Outstanding wallet-auth challenge ceiling (bounds auth_nonces growth under
# distributed challenge spam). Default 50000.
# NEONRELAY_AUTH_NONCE_CAP=50000
# Per (wallet binding, epoch) stored match-intent ceiling (bounds economy_matches
# growth and the epoch-close RPC fan-out). Default 64.
# NEONRELAY_MAX_MATCH_INTENTS_PER_EPOCH=64

# Operator-set on-chain ids. The values below match the repository examples,
# but remain UNVERIFIED until anchor/solana toolchains are available and the
# deployment is checked against RPC.
NEONRELAY_REWARDS_PROGRAM_ID=2RaaXKUutemHtSZUsmnEv41ytWMkaXD6rcoziHGLRtmj
NEONRELAY_FEATURES_PROGRAM_ID=4PH1dHVBRbfoydBx3SuRjAS46zRRjHvRxWCNcrFBDqYP
NEONRELAY_ECONOMY_PROGRAM_ID=FZcLDdUrs6i1HYFFK2NhqNrbVaP6KTvrqzhyoDGT6CV9
NEONRELAY_ASSETS_PROGRAM_ID=F5VhZxGGEY61TNNexRwJVomMZtHeAZodqVHPMqoxq3oc
NEONRELAY_IDENTITY_PROGRAM_ID=CgInv
NEONRELAY_SESSION_KEYS_PROGRAM_ID=SessKeys
NEONRELAY_TREASURY_PROGRAM_ID=STrEaSuRy

# Optional devnet-only mints. Never treat these as official or valuable.
# NEONRELAY_REWARD_MINT=   # production: must equal the rewards Config mint
# NEONRELAY_SKR_MINT=
# NEONRELAY_POTATO_MINT=

# Optional alert sinks.
# NEONRELAY_ALERT_WEBHOOK_URL=
# NEONRELAY_TELEGRAM_BOT_TOKEN=
# NEONRELAY_TELEGRAM_CHAT_ID=
